# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (contact form + newsletter signup notifications)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# Supabase (student portal auth + database)
# Create a project at https://supabase.com (EU/Frankfurt region recommended
# for UK data residency), then run supabase/schema.sql in its SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Project Settings > API > service_role in Supabase.
# SECRET: bypasses Row Level Security. Server-only, used only by the
# subscription webhook and the video-player page's signed-URL generation.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required on requests to /api/webhooks/subscription (sent as
# the X-Webhook-Secret header) — this is what the future booking app (or
# Stripe, or a manual test call) authenticates with to flip a student's
# subscription_status. Generate any long random string.
SUBSCRIPTION_WEBHOOK_SECRET=

# Google Places API (New) — live Google reviews on the homepage
# 1. Create/select a project in Google Cloud Console, enable "Places API (New)".
# 2. Create an API key restricted to Places API (New) — server-side only, never expose this key.
# 3. Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
